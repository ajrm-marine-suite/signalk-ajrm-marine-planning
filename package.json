{
  "name": "signalk-ajrm-marine-planning",
  "version": "0.5.19",
  "description": "Consolidated Signal K gate-passage and anchor-force planning using shared locations, tides and weather.",
  "keywords": [
    "signalk-node-server-plugin",
    "signalk-webapp",
    "signalk-category-navigation",
    "signal-k",
    "marine",
    "tides",
    "weather",
    "anchoring",
    "passage-planning"
  ],
  "main": "plugin/index.cjs",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "sync:shared-ui": "node scripts/sync-shared-ui.mjs",
    "test": "npm run sync:shared-ui && node --check plugin/index.cjs && node --check public/suite.js && node --check public/gate/app.js && node --check public/anchor/app.js && node --test test/*.test.cjs"
  },
  "signalk-plugin-enabled-by-default": true,
  "signalk": {
    "displayName": "AJRM Marine Planning",
    "appIcon": "./icon-120.png"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ajrm-marine-suite/signalk-ajrm-marine-planning.git"
  },
  "author": "Anthony McDonald, with assistance from William McAusland",
  "license": "AGPL-3.0-or-later",
  "devDependencies": {
    "@ajrm-marine/map-core": "github:ajrm-marine-suite/ajrm-marine-map-core#v0.7.13"
  },
  "bugs": {
    "url": "https://github.com/ajrm-marine-suite/signalk-ajrm-marine-planning/issues"
  },
  "homepage": "https://github.com/ajrm-marine-suite/signalk-ajrm-marine-planning#readme",
  "files": [
    "plugin",
    "public",
    "icon-120.png",
    "defaults",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ]
}
